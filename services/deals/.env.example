# Server only. Copy to .env.deals.runtime.local; never use EXPO_PUBLIC_ for secrets.
DATABASE_URL=postgresql://deals_api:REPLACE@localhost:5432/deals
WORKER_DATABASE_URL=postgresql://deals_worker:REPLACE@localhost:5432/deals
# Set only for migration/provisioning commands, never the running API/worker.
ADMIN_DATABASE_URL=
DEALS_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
DEALS_AUTH_ISSUER=nessiessential
DEALS_AUTH_AUDIENCE=nessiessential-api
DEALS_ALLOW_TEST_FIXTURES=0
PORT=3001
HOST=127.0.0.1
PHOTON_API_BASE_URL=https://api.photon.codes
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
PHOTON_EMAIL_DOMAIN=deals.getcompfy.com
PHOTON_WEBHOOK_SECRET=
PHOTON_WEBHOOK_URL=
PHOTON_WEBHOOK_DESTINATION_ID=
PHOTON_OPERATION_ID=pho_opr_01m6wm910dfvk94fa4jh8gv7b9
PHOTON_RECONCILE_INTERVAL_SECONDS=300
PHOTON_EMAIL_ENTITLEMENT_CONFIRMED=false
NESSIE_API_BASE_URL=https://v2-prod-api.nessieisreal.com
NESSIE_API_KEY=
# Optional OpenAI-compatible Nemotron endpoint, server only.
NEMOTRON_BASE_URL=
NEMOTRON_API_KEY=
NEMOTRON_MODEL=
