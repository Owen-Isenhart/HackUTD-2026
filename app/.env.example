# Copy to app/.env.local (git ignores it) and restart Expo.
# HTTPS origin of the finance backend (repo root: npm run finance:serve, port 8787), usually a tunnel.
# The demo token is typed in the app's "Best choice here" card, not stored here.
EXPO_PUBLIC_FINANCE_API_URL=

# Voice assistant (services/calls: bash scripts/dev_up.sh). Address of the calls API as the PHONE sees it,
# e.g. http://<this computer's LAN IP>:8000. The service key is typed in the app, never stored here.
EXPO_PUBLIC_VOICE_API_URL=
# Optional. The user the voice session is for (the server must trust this; demo only).
EXPO_PUBLIC_VOICE_USER_ID=demo-user
# DEV ONLY, optional: skips typing the voice service key. EXPO_PUBLIC_* values end up in the served
# JavaScript, so never put a real secret here or ship a build that has it. Leave empty to type the key in the app.
EXPO_PUBLIC_VOICE_API_KEY=
EXPO_PUBLIC_DEMO_SNAPSHOT=1  # answer every backend call from the frozen Alex Taylor snapshot (no backend needed)
