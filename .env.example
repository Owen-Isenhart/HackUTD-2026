# Optional Photon 2.0 iMessage test. Use an opted-in teammate as the recipient.
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
PHOTON_AGENT_USER_ID=
PHOTON_RECIPIENT=

# Server-side only. Use a Nessie sandbox account for the demo.
NESSIE_API_KEY=
NESSIE_ACCOUNT_ID=
FINANCE_TIME_ZONE=America/Chicago
NEMOTRON_BASE_URL=http://127.0.0.1:8000/v1
NEMOTRON_MODEL=nemotron-bolt
NEMOTRON_API_KEY=
TIGER_DATA_URL=
# Optional when TIGER_DATA_URL already includes the password.
TIGER_DATA_PASSWORD=

# Set a random token (at least 24 characters) when running finance:serve.
FINANCE_DEMO_TOKEN=
FINANCE_PORT=8787

# Optional HTTPS origin of the finance backend for Expo Go. This URL is public.
EXPO_PUBLIC_FINANCE_API_URL=
