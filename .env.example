# Optional Photon 2.0 iMessage test. Use an opted-in teammate as the recipient.
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
PHOTON_AGENT_USER_ID=
PHOTON_RECIPIENT=

# Server-side only. Use a Nessie sandbox account for the demo.
NESSIE_API_KEY=
NESSIE_ACCOUNT_ID=
FINANCE_TIME_ZONE=America/Chicago
NEMOTRON_BASE_URL=http://127.0.0.1:8000/v1
NEMOTRON_MODEL=nemotron-bolt
NEMOTRON_API_KEY=
TIGER_DATA_URL=
# Optional when TIGER_DATA_URL already includes the password.
TIGER_DATA_PASSWORD=

# Set a random token (at least 24 characters) when running finance:serve.
FINANCE_DEMO_TOKEN=
FINANCE_PORT=8787

# Optional recommendation calls. Apply the Tiger Data migrations first. Use distinct
# random keys of at least 24 characters for finance, dialing, and the voice agent.
CALL_RECOMMENDATION_USER_ID=
RECOMMENDATION_API_KEY=
CALLS_API_URL=http://127.0.0.1:8788
CALLS_API_KEY=
# Set only to an allowlisted recipient who has opted in to the test.
CALL_RECOMMENDATION_TO_NUMBER=
CALL_ALLOW_DEMO_LOCATION=0
# Enables automatic delivery of explicitly labeled fixture offers to opted-in recipients.
ALERT_ALLOW_DEMO_CATALOG=0
# Optional private Python optimizer. Set both values to enable the service path.
OPTIMIZER_API_URL=
OPTIMIZER_API_KEY=
# Optional same-origin Deals gateway. Provision this tenant on the Deals service first.
DEALS_API_URL=
DEALS_OWNER_ID=
DEALS_AUTH_SECRET=

# Photon texts -> financial plans (server-side only). Reuses the shared Beta
# project. PHOTON_PROJECT_ID and PHOTON_API_KEY come from the project owner.
# PHOTON_TEXT_OWNER_HANDLES lists the consenting user's own phone numbers (E.164,
# comma-separated); friends' texts are read only in conversations that user
# shares with the Nessie line.
PHOTON_TEXT_OWNER_HANDLES=
PHOTON_TEXT_PLATFORMS=sms
PHOTON_TEXT_RESOURCE_ID=pho_res_01m6wh7e9zeh7v79r9h2a8fdda
PHOTON_TEXT_POLL_SECONDS=60
# Gmail / Google Calendar via Photon email: a finance alias on deals.getcompfy.com
# allocated through the deals owner/consent flow (not an arbitrary address). The
# user's Gmail filter forwards bills, payment requests, reservations and Calendar
# notifications to it. Comma-separated for several aliases of the same user.
PHOTON_FINANCE_EMAIL_ADDRESSES=
# Only for a separate text webhook destination (not the shared email one).
PHOTON_TEXT_WEBHOOK_SECRET=

# Optional HTTPS origin of the finance backend for Expo Go. This URL is public.
EXPO_PUBLIC_FINANCE_API_URL=
